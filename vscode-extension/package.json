{
  "name": "md-collab-vscode",
  "displayName": "md-collab",
  "description": "Inline Markdown collaboration sidecar UI",
  "version": "0.1.7",
  "publisher": "md-collab",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onView:mdCollab.threadChat",
    "onView:mdCollab.threads",
    "onLanguage:markdown",
    "onCommand:mdCollab.addComment",
    "onCommand:mdCollab.replyToThread",
    "onCommand:mdCollab.navigateToThread",
    "onCommand:mdCollab.resolveThread",
    "onCommand:mdCollab.reopenThread",
    "onCommand:mdCollab.reanchorCurrentFile",
    "onCommand:mdCollab.reloadSidecar",
    "onCommand:mdCollab.openThreadPanel",
    "onCommand:mdCollab.openSidecarForRepair",
    "onCommand:mdCollab.showConflictHelp",
    "onCommand:mdCollab.showBaseVersionHelp",
    "onCommand:mdCollab.proposeSuggestion",
    "onCommand:mdCollab.proposeSuggestionFromSelection",
    "onCommand:mdCollab.applySuggestion",
    "onCommand:mdCollab.rejectSuggestion",
    "onCommand:mdCollab.viewSuggestionBaseVersion",
    "onCommand:mdCollab.openLegacyThreadPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdCollab.addComment",
        "title": "md-collab: Add Comment"
      },
      {
        "command": "mdCollab.replyToThread",
        "title": "md-collab: Reply to Thread"
      },
      {
        "command": "mdCollab.navigateToThread",
        "title": "md-collab: Jump to Thread Anchor"
      },
      {
        "command": "mdCollab.resolveThread",
        "title": "md-collab: Resolve Thread"
      },
      {
        "command": "mdCollab.reopenThread",
        "title": "md-collab: Reopen Thread"
      },
      {
        "command": "mdCollab.reanchorCurrentFile",
        "title": "md-collab: Reanchor Current File"
      },
      {
        "command": "mdCollab.reloadSidecar",
        "title": "md-collab: Reload Sidecar"
      },
      {
        "command": "mdCollab.openThreadPanel",
        "title": "md-collab: Open Thread Panel"
      },
      {
        "command": "mdCollab.openSidecarForRepair",
        "title": "md-collab: Open Sidecar for Repair"
      },
      {
        "command": "mdCollab.showConflictHelp",
        "title": "md-collab: Conflict Help"
      },
      {
        "command": "mdCollab.showBaseVersionHelp",
        "title": "md-collab: Base Version Help"
      },
      {
        "command": "mdCollab.proposeSuggestion",
        "title": "md-collab: Propose Suggestion"
      },
      {
        "command": "mdCollab.proposeSuggestionFromSelection",
        "title": "md-collab: Propose Suggestion from Selection (Auto-create Thread)"
      },
      {
        "command": "mdCollab.applySuggestion",
        "title": "md-collab: Apply Suggestion"
      },
      {
        "command": "mdCollab.rejectSuggestion",
        "title": "md-collab: Reject Suggestion"
      },
      {
        "command": "mdCollab.viewSuggestionBaseVersion",
        "title": "md-collab: View Suggestion Base Version"
      },
      {
        "command": "mdCollab.openLegacyThreadPanel",
        "title": "md-collab: Open Legacy Thread Tree"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mdCollab.addComment",
          "when": "editorTextFocus && editorHasSelection && resourceExtname == .md",
          "group": "navigation@50"
        },
        {
          "command": "mdCollab.proposeSuggestionFromSelection",
          "when": "editorTextFocus && editorHasSelection && resourceExtname == .md",
          "group": "navigation@51"
        }
      ],
      "view/item/context": [
        {
          "command": "mdCollab.resolveThread",
          "when": "view == mdCollab.threads && viewItem == mdCollab.thread.open",
          "group": "inline@10"
        },
        {
          "command": "mdCollab.reopenThread",
          "when": "view == mdCollab.threads && viewItem == mdCollab.thread.resolved",
          "group": "inline@10"
        },
        {
          "command": "mdCollab.proposeSuggestion",
          "when": "view == mdCollab.threads && (viewItem == mdCollab.thread.open || viewItem == mdCollab.thread.resolved)",
          "group": "inline@20"
        },
        {
          "command": "mdCollab.applySuggestion",
          "when": "view == mdCollab.threads && viewItem == mdCollab.suggestion.proposed",
          "group": "inline@30"
        },
        {
          "command": "mdCollab.rejectSuggestion",
          "when": "view == mdCollab.threads && viewItem == mdCollab.suggestion.proposed",
          "group": "inline@31"
        },
        {
          "command": "mdCollab.viewSuggestionBaseVersion",
          "when": "view == mdCollab.threads && (viewItem == mdCollab.suggestion.proposed || viewItem == mdCollab.suggestion.applied || viewItem == mdCollab.suggestion.rejected || viewItem == mdCollab.suggestion.obsolete)",
          "group": "navigation@40"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdCollab.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorHasSelection && resourceExtname == .md"
      }
    ],
    "configuration": {
      "title": "md-collab",
      "properties": {
        "mdCollab.authorId": {
          "type": "string",
          "default": "",
          "description": "Author ID used for comment writes. Required for write actions."
        },
        "mdCollab.authorLabel": {
          "type": "string",
          "default": "",
          "description": "Display label used for comment writes. Required for write actions."
        },
        "mdCollab.showResolvedInline": {
          "type": "boolean",
          "default": false,
          "description": "Render resolved thread inline markers."
        },
        "mdCollab.reanchorOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Reanchor comments automatically when a markdown file is saved."
        },
        "mdCollab.workspaceSnapshotId": {
          "type": "string",
          "default": "",
          "description": "Optional workspace snapshot ID for local-draft timeline relevance checks."
        },
        "mdCollab.timelineKind": {
          "type": "string",
          "enum": [
            "workspace",
            "git",
            "hybrid"
          ],
          "default": "workspace",
          "description": "Timeline provenance mode for new thread/message version context."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdCollab",
          "title": "md-collab",
          "icon": "resources/comment.svg"
        }
      ]
    },
    "views": {
      "mdCollab": [
        {
          "id": "mdCollab.threadChat",
          "name": "Threads"
        },
        {
          "id": "mdCollab.threads",
          "name": "Threads (Legacy Tree)"
        }
      ]
    }
  },
  "scripts": {
    "precompile": "npm --prefix .. run build && node ./scripts/sync-core.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.24",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.9.2"
  }
}
