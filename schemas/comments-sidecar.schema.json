{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-collab.local/schemas/comments-sidecar.schema.json",
  "title": "md-collab comments sidecar",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "document",
    "threads"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thread"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "author_id",
        "author_label",
        "verified"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "author_label": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "line",
        "column",
        "offset_utf16"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset_utf16": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "message_id",
        "author",
        "body",
        "created_at",
        "edited_at"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "edited_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "message_version_context": {
          "$ref": "#/$defs/messageVersionContext"
        }
      }
    },
    "timelineKind": {
      "type": "string",
      "enum": ["workspace", "git", "hybrid"]
    },
    "messageVersionContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/timelineKind" },
        "seen_workspace_snapshot_id": { "type": "string" },
        "seen_head_commit": { "type": "string" },
        "seen_blob_sha": { "type": "string" }
      }
    },
    "threadVersionContext": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": { "$ref": "#/$defs/timelineKind" },
        "workspace_snapshot_id": { "type": "string" },
        "workspace_file_hash": { "type": "string" },
        "workspace_file_mtime": { "$ref": "#/$defs/timestamp" },
        "workspace_actor_session_id": { "type": "string" },
        "base_commit": { "type": "string" },
        "head_commit": { "type": "string" },
        "file_path_at_create": { "type": "string" },
        "base_blob_sha": { "type": "string" },
        "head_blob_sha": { "type": "string" },
        "anchor_at_create": { "type": "object", "additionalProperties": true }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "thread_id",
        "status",
        "anchor",
        "author",
        "messages",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "anchor": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "primary",
            "fallback",
            "anchor_confidence"
          ],
          "properties": {
            "primary": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/point"
                },
                "end": {
                  "$ref": "#/$defs/point"
                },
                "doc_revision": {
                  "type": "string"
                }
              }
            },
            "fallback": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "quote",
                "prefix",
                "suffix",
                "quote_hash",
                "context_hash"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "prefix": {
                  "type": "string"
                },
                "suffix": {
                  "type": "string"
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^sha256:.+"
                },
                "context_hash": {
                  "type": "string",
                  "pattern": "^sha256:.+"
                }
              }
            },
            "anchor_confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "broken"
              ]
            }
          }
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "thread_version_context": {
          "$ref": "#/$defs/threadVersionContext"
        },
        "relevance_state": {
          "type": "string",
          "enum": ["active", "outdated", "orphaned"]
        },
        "relevance_reason": {
          "type": "string",
          "enum": [
            "CONTENT_CHANGED",
            "ANCHOR_RELOCATED",
            "ANCHOR_NOT_FOUND",
            "FILE_RENAMED",
            "FILE_DELETED",
            "COMMIT_CONTEXT_UNAVAILABLE",
            "WORKSPACE_CONTEXT_UNAVAILABLE"
          ]
        },
        "relevance_checked_at": {
          "$ref": "#/$defs/timestamp"
        },
        "relevance_checked_against_commit": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["suggestion_id", "thread_id", "status", "proposed_edit", "proposed_by", "proposed_at"],
            "properties": {
              "suggestion_id": { "type": "string", "minLength": 1 },
              "thread_id": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["proposed", "applied", "rejected", "obsolete"] },
              "proposed_edit": {
                "type": "object",
                "additionalProperties": true,
                "required": ["anchor", "before_text_hash", "replacement_text"],
                "properties": {
                  "anchor": { "type": "object", "additionalProperties": true },
                  "before_text_hash": { "type": "string", "pattern": "^sha256:.+" },
                  "replacement_text": { "type": "string" }
                }
              },
              "proposed_by": { "$ref": "#/$defs/author" },
              "proposed_at": { "$ref": "#/$defs/timestamp" },
              "decision": {
                "type": "object",
                "additionalProperties": true,
                "required": ["decided_by", "decided_at"],
                "properties": {
                  "decided_by": { "$ref": "#/$defs/author" },
                  "decided_at": { "$ref": "#/$defs/timestamp" },
                  "decision_reason": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
