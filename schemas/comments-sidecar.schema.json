{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-collab.local/schemas/comments-sidecar.schema.json",
  "title": "md-collab comments sidecar",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "document",
    "threads"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "document": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "threads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thread"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "author_id",
        "author_label",
        "verified"
      ],
      "properties": {
        "author_id": {
          "type": "string",
          "minLength": 1
        },
        "author_label": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "line",
        "column",
        "offset_utf16"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "offset_utf16": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "message_id",
        "author",
        "body",
        "created_at",
        "edited_at"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "body": {
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "edited_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "thread": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "thread_id",
        "status",
        "anchor",
        "author",
        "messages",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "thread_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "anchor": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "primary",
            "fallback",
            "anchor_confidence"
          ],
          "properties": {
            "primary": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/point"
                },
                "end": {
                  "$ref": "#/$defs/point"
                },
                "doc_revision": {
                  "type": "string"
                }
              }
            },
            "fallback": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "quote",
                "prefix",
                "suffix",
                "quote_hash",
                "context_hash"
              ],
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "prefix": {
                  "type": "string"
                },
                "suffix": {
                  "type": "string"
                },
                "quote_hash": {
                  "type": "string",
                  "pattern": "^sha256:.+"
                },
                "context_hash": {
                  "type": "string",
                  "pattern": "^sha256:.+"
                }
              }
            },
            "anchor_confidence": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "broken"
              ]
            }
          }
        },
        "author": {
          "$ref": "#/$defs/author"
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
