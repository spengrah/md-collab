+
+fn thread_inline_affordance(
+    window_tab_data: Rc<WindowTabData>,
+    editor: RwSignal<EditorData>,
+) -> impl View {
+    let config = window_tab_data.common.config;
+    label(|| "💬 Thread t-1".to_string())
+        .on_click_stop(move |_| {
+            window_tab_data.panel.show_panel(&PanelKind::Thread);
+            window_tab_data.common.focus.set(Focus::Panel(PanelKind::Thread));
+            let editor = editor.get_untracked();
+            if let Some(editor_tab_id) = editor.editor_tab_id.get_untracked() {
+                window_tab_data
+                    .common
+                    .internal_command
+                    .send(InternalCommand::FocusEditorTab { editor_tab_id });
+            }
+        })
+        .style(move |s| {
+            let config = config.get();
+            let line_height = config.editor.line_height() as f32;
+            s.absolute()
+                .margin_left(48.0)
+                .margin_top(line_height * 2.0)
+                .padding_horiz(6.0)
+                .height(line_height - 4.0)
+                .border_radius(4.0)
+                .cursor(CursorStyle::Pointer)
+                .background(config.color(LapceColor::PANEL_HOVERED_BACKGROUND))
+                .color(config.color(LapceColor::EDITOR_FOREGROUND))
+        })
+}
